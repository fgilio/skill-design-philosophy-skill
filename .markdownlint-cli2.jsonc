{
  "config": {
    "default": true,
    // The formatter keeps each paragraph on one line.
    "MD013": false,
  },
  "globs": ["**/*.{md,mdx}"],
  "gitignore": true,
  "ignores": ["node_modules/**", "**/results/**"],
  "overrides": [
    {
      // The PR template is the body of a pull request description. It opens
      // with a guidance comment and a "Closes:" line, not a heading.
      "filter": ["**/.github/pull_request_template.md"],
      "config": { "MD041": false },
      "combine": "merge",
    },
  ],
}
