{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "proseWrap": "never",
  "printWidth": 80,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ],
  "ignorePatterns": ["node_modules"]
}
